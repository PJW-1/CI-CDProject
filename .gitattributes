# 쉘 스크립트는 반드시 LF 여야 한다.
# Windows에서 체크아웃 시 CRLF로 변환되면 컨테이너가 기동하지 못한다:
#   exec ./entrypoint.sh: no such file or directory
# (이번 작업 중 git worktree 체크아웃에서 실제로 발생했다)
*.sh text eol=lf

# 컨테이너 안에서 읽히는 설정/의존성 파일도 LF 로 고정한다.
*.yaml text eol=lf
*.yml  text eol=lf
requirements*.txt text eol=lf
Dockerfile text eol=lf
